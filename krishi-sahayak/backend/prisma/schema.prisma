generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  FARMER
  MARKETER
}

enum CropStatus {
  PLANNED
  SOWN
  GROWING
  READY_FOR_HARVEST
  HARVESTED
  SOLD
}

enum ActivityStatus {
  PENDING
  COMPLETED
  SKIPPED
}

enum OrderStatus {
  CREATED
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  COMPLETED
  CANCELLED
}

enum ListingStatus {
  ACTIVE
  NEGOTIATING
  SOLD
  EXPIRED
}

enum OfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

enum ApplicationStatus {
  NOT_APPLIED
  APPLIED
  UNDER_REVIEW
  APPROVED
  REJECTED
  COMPLETED
}

enum PaymentStatus {
  PENDING
  RECEIVED
}

enum AppointmentStatus {
  REQUESTED
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum TransportRequestStatus {
  REQUESTED
  ACCEPTED
  IN_TRANSIT
  COMPLETED
  CANCELLED
}

model User {
  id                  String              @id @default(cuid())
  name                String
  email               String              @unique
  phone               String?
  passwordHash        String
  role                UserRole            @default(FARMER)
  isActive            Boolean             @default(true)
  tokenVersion        Int                 @default(0)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  farmerProfile       FarmerProfile?
  marketerProfile     MarketerProfile?
  supplierProfile     Supplier?
  healthcareProfile   HealthcareProvider?
  transportProfile    TransportProvider?
  farms               Farm[]
  crops               Crop[]
  cart                Cart?
  purchaseOrders      Order[]
  cropListings        CropListing[]
  buyerOffers         BuyerOffer[]
  cropSalesAsFarmer   CropSale[]          @relation("CropSaleFarmer")
  cropSalesAsBuyer    CropSale[]          @relation("CropSaleBuyer")
  income              Income[]
  expenses            Expense[]
  bills               Bill[]
  documents           Document[]
  schemeApplications  SchemeApplication[]
  governmentPayments  GovernmentPayment[]
  notifications       Notification[]
  appointments        Appointment[]
  transportRequests   TransportRequest[]
  aiConversations     AIConversation[]
  reviews             Review[]
  complaints          Complaint[]
  passwordResetTokens PasswordResetToken[]
  trackedSchemes      TrackedScheme[]

  @@index([role])
}

model FarmerProfile {
  id                String   @id @default(cuid())
  userId            String   @unique
  district          String?
  state             String?
  preferredLanguage String   @default("en")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MarketerProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  organization   String?
  marketLocation String?
  businessType   String?
  bio            String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Farm {
  id             String       @id @default(cuid())
  ownerId        String
  name           String
  area           Decimal      @db.Decimal(10, 2)
  areaUnit       String
  location       String?
  district       String?
  state          String?
  soilType       String?
  irrigationType String?
  latitude       Float?
  longitude      Float?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  owner          User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  crops          Crop[]
  soilRecords    SoilRecord[]
  expenses       Expense[]

  @@index([ownerId])
  @@index([district, state])
}

model Crop {
  id                  String         @id @default(cuid())
  farmerId            String
  farmId              String
  name                String
  variety             String?
  area                Decimal        @db.Decimal(10, 2)
  sowingDate          DateTime?
  expectedHarvestDate DateTime?
  status              CropStatus     @default(PLANNED)
  notes               String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  farmer              User           @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  farm                Farm           @relation(fields: [farmId], references: [id], onDelete: Cascade)
  activities          CropActivity[]
  income              Income[]
  expenses            Expense[]
  bills               Bill[]
  listings            CropListing[]
  transportRequests   TransportRequest[]

  @@index([farmerId, farmId])
  @@index([status])
}

model CropActivity {
  id          String         @id @default(cuid())
  cropId      String
  title       String
  description String?
  dueDate     DateTime
  status      ActivityStatus @default(PENDING)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  crop        Crop           @relation(fields: [cropId], references: [id], onDelete: Cascade)

  @@index([cropId, dueDate])
  @@index([status])
}

model SoilRecord {
  id         String   @id @default(cuid())
  farmId     String
  ph         Float?
  nitrogen   Float?
  phosphorus Float?
  potassium  Float?
  notes      String?
  testedAt   DateTime @default(now())
  createdAt  DateTime @default(now())

  farm       Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)

  @@index([farmId, testedAt])
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  products    Product[]
}

model Supplier {
  id           String    @id @default(cuid())
  userId       String?   @unique
  businessName String
  contact      String?
  location     String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user         User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  products     Product[]
}

model Product {
  id              String      @id @default(cuid())
  supplierId      String
  categoryId      String
  name            String
  description     String?
  price           Decimal     @db.Decimal(12, 2)
  unit            String
  stock           Int         @default(0)
  imageUrl        String?
  cropSuitability String?
  isActive        Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  supplier        Supplier    @relation(fields: [supplierId], references: [id])
  category        Category    @relation(fields: [categoryId], references: [id])
  inventory       Inventory?
  cartItems       CartItem[]
  orderItems      OrderItem[]

  @@index([categoryId, supplierId])
  @@index([name])
}

model Inventory {
  id        String   @id @default(cuid())
  productId String   @unique
  quantity  Int
  updatedAt DateTime @updatedAt

  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  updatedAt DateTime   @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
}

model CartItem {
  id        String  @id @default(cuid())
  cartId    String
  productId String
  quantity  Int

  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])

  @@unique([cartId, productId])
}

model Order {
  id          String      @id @default(cuid())
  orderNumber String      @unique
  buyerId     String
  status      OrderStatus @default(CREATED)
  total       Decimal     @db.Decimal(12, 2)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  buyer       User        @relation(fields: [buyerId], references: [id])
  items       OrderItem[]

  @@index([buyerId, status])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  unitPrice Decimal @db.Decimal(12, 2)

  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])
}

model CropListing {
  id            String        @id @default(cuid())
  farmerId      String
  cropId        String?
  cropName      String
  variety       String?
  quantity      Decimal       @db.Decimal(12, 2)
  unit          String
  expectedPrice Decimal       @db.Decimal(12, 2)
  grade         String?
  harvestDate   DateTime?
  location      String
  description   String?
  imageUrls     String[]
  status        ListingStatus @default(ACTIVE)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  farmer        User          @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  crop          Crop?         @relation(fields: [cropId], references: [id], onDelete: SetNull)
  offers        BuyerOffer[]
  sale          CropSale?

  @@index([farmerId, status])
  @@index([cropName, location])
}

model BuyerOffer {
  id        String      @id @default(cuid())
  buyerId   String
  listingId String
  quantity  Decimal     @db.Decimal(12, 2)
  price     Decimal     @db.Decimal(12, 2)
  message   String?
  status    OfferStatus @default(PENDING)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  buyer     User        @relation(fields: [buyerId], references: [id])
  listing   CropListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  sale      CropSale?

  @@index([listingId, status])
  @@index([buyerId])
}

model CropSale {
  id        String       @id @default(cuid())
  farmerId  String
  buyerId   String?
  listingId String?      @unique
  offerId   String?      @unique
  buyerName String?
  amount    Decimal      @db.Decimal(12, 2)
  quantity  Decimal?     @db.Decimal(12, 2)
  unit      String?
  soldAt    DateTime     @default(now())

  farmer    User         @relation("CropSaleFarmer", fields: [farmerId], references: [id], onDelete: Cascade)
  buyer     User?        @relation("CropSaleBuyer", fields: [buyerId], references: [id], onDelete: SetNull)
  listing   CropListing? @relation(fields: [listingId], references: [id], onDelete: SetNull)
  offer     BuyerOffer?  @relation(fields: [offerId], references: [id], onDelete: SetNull)
}

model MarketPrice {
  id         String   @id @default(cuid())
  crop       String
  market     String
  location   String
  date       DateTime
  minPrice   Decimal  @db.Decimal(12, 2)
  maxPrice   Decimal  @db.Decimal(12, 2)
  modalPrice Decimal? @db.Decimal(12, 2)
  unit       String
  source     String
  isDemo     Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@index([crop, date])
  @@index([market, location])
}

model Income {
  id          String   @id @default(cuid())
  farmerId    String
  cropId      String?
  source      String
  amount      Decimal  @db.Decimal(12, 2)
  date        DateTime
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  farmer      User     @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  crop        Crop?    @relation(fields: [cropId], references: [id], onDelete: SetNull)

  @@index([farmerId, date])
  @@index([cropId])
}

model Expense {
  id          String   @id @default(cuid())
  farmerId    String
  cropId      String?
  farmId      String?
  category    String
  amount      Decimal  @db.Decimal(12, 2)
  date        DateTime
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  farmer      User     @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  crop        Crop?    @relation(fields: [cropId], references: [id], onDelete: SetNull)
  farm        Farm?    @relation(fields: [farmId], references: [id], onDelete: SetNull)

  @@index([farmerId, date])
  @@index([category])
}

model Bill {
  id                 String   @id @default(cuid())
  farmerId           String
  cropId             String?
  fileUrl            String
  vendor             String?
  billDate           DateTime?
  category           String?
  totalAmount        Decimal? @db.Decimal(12, 2)
  tax                Decimal? @db.Decimal(12, 2)
  description        String?
  ocrStatus          String   @default("PENDING")
  verificationStatus String   @default("PENDING")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  farmer             User     @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  crop               Crop?    @relation(fields: [cropId], references: [id], onDelete: SetNull)

  @@index([farmerId])
  @@index([category])
}

model Document {
  id        String   @id @default(cuid())
  ownerId   String
  type      String
  fileUrl   String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, type])
}

model GovernmentScheme {
  id                 String              @id @default(cuid())
  name               String
  description        String
  eligibility        String
  benefits           String
  requiredDocuments  String
  applicationProcess String
  officialSource     String
  deadline           DateTime?
  state              String?
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  applications       SchemeApplication[]
  payments           GovernmentPayment[]

  @@index([state, isActive])
}

model SchemeApplication {
  id        String            @id @default(cuid())
  farmerId  String
  schemeId  String
  status    ApplicationStatus @default(NOT_APPLIED)
  notes     String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  farmer    User              @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  scheme    GovernmentScheme  @relation(fields: [schemeId], references: [id])

  @@unique([farmerId, schemeId])
  @@index([status])
}

model GovernmentPayment {
  id         String            @id @default(cuid())
  farmerId   String
  schemeId   String?
  schemeName String
  amount     Decimal           @db.Decimal(12, 2)
  date       DateTime
  reference  String?
  status     PaymentStatus      @default(PENDING)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  farmer     User               @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  scheme     GovernmentScheme?  @relation(fields: [schemeId], references: [id], onDelete: SetNull)

  @@index([farmerId])
  @@index([status])
}

model WeatherRecord {
  id              String   @id @default(cuid())
  location        String
  temperature     Float
  humidity        Float
  rainProbability Float
  wind            Float
  condition       String
  forecast        Json?
  recordedAt      DateTime @default(now())
  isDemo          Boolean  @default(true)

  @@index([location, recordedAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

model HealthcareProvider {
  id             String        @id @default(cuid())
  userId         String?       @unique
  name           String
  specialization String
  location       String
  contact        String
  availability   String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  appointments   Appointment[]

  @@index([location])
}

model Appointment {
  id          String             @id @default(cuid())
  farmerId    String
  providerId  String
  requestedAt DateTime
  status      AppointmentStatus  @default(REQUESTED)
  notes       String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  farmer      User               @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  provider    HealthcareProvider @relation(fields: [providerId], references: [id])

  @@index([farmerId, status])
}

model TransportProvider {
  id               String             @id @default(cuid())
  userId           String?            @unique
  name             String
  vehicleType      String
  capacity         String
  serviceArea      String
  contact          String
  approximatePrice Decimal?           @db.Decimal(12, 2)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  user             User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  requests         TransportRequest[]

  @@index([serviceArea])
}

model TransportRequest {
  id            String                 @id @default(cuid())
  farmerId      String
  providerId    String?
  cropId        String?
  cropName      String
  quantity      Decimal                @db.Decimal(12, 2)
  pickup        String
  destination   String
  scheduledDate DateTime
  notes         String?
  status        TransportRequestStatus @default(REQUESTED)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  farmer        User                   @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  provider      TransportProvider?     @relation(fields: [providerId], references: [id], onDelete: SetNull)
  crop          Crop?                  @relation(fields: [cropId], references: [id], onDelete: SetNull)

  @@index([farmerId, status])
  @@index([providerId, status])
}

model AIConversation {
  id        String      @id @default(cuid())
  userId    String
  title     String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  AIMessage[]

  @@index([userId, createdAt])
}

model AIMessage {
  id             String         @id @default(cuid())
  conversationId String
  role           String
  content        String
  metadata       Json?
  createdAt      DateTime       @default(now())

  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  rating    Int
  content   String?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Complaint {
  id          String   @id @default(cuid())
  userId      String
  subject     String
  description String
  status      String   @default("OPEN")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model TrackedScheme {
  id           String   @id @default(cuid())
  userId       String
  name         String
  officialUrl  String?
  status       String   @default("RESEARCHING")
  deadline     DateTime?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
}

model SupportMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  status    String   @default("OPEN")
  createdAt DateTime @default(now())

  @@index([createdAt])
}
