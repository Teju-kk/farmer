# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/krishi_sahayak?schema=public"

# Authentication and API
NODE_ENV=development
ALLOW_DEMO_SEED=false
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="7d"
PORT=4000
FRONTEND_URL="http://localhost:5173"
TRUST_PROXY_HOPS=0

# Private file storage (local for development; production must use Supabase)
STORAGE_PROVIDER="local"
UPLOAD_DIR="uploads"
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="krishi-bills"

# Email provider (Resend)
RESEND_API_KEY=""
EMAIL_FROM=""
SUPPORT_EMAIL=""

# Commercial Open-Meteo API (required in production)
WEATHER_API_KEY=""

# Optional OpenAI Responses API assistant
AI_API_KEY=""
AI_MODEL="gpt-4o-mini"
